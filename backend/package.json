{
  "name": "interview-coder-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone backend for Interview Coder",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node server.js --migrate-only",
