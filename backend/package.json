    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.20.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "wrangler": "^4.71.0"
  }
}
