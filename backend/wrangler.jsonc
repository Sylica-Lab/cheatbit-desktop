{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "interview-coder-backend",
  "main": "./worker.mjs",
  "compatibility_date": "2026-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../landing-static",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/admin", "/health", "/billing/*", "/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS_BUCKET",
      "bucket_name": "sylica-ai-downloads"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eb58aa1a47e04764a060d3ce0ca8df13"
    }
  ],
  "vars": {
    "RUN_DB_MIGRATIONS_ON_START": "false"
  }
}
