{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "interview-coder-backend",
  "main": "./worker.mjs",
  "compatibility_date": "2026-03-08",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/admin", "/health", "/billing/*", "/api/*"]
  },
  "vars": {
    "RUN_DB_MIGRATIONS_ON_START": "false"
  }
}
