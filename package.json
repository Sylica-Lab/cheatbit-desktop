{
  "name": "sylica-ai-desktop",
  "version": "1.0.45",
  "main": "./dist-electron/electron/main.js",
  "scripts": {
    "clean": "npx rimraf dist dist-electron",
    "backend:install": "npm --prefix backend install",
    "backend:start": "npm --prefix backend run start",
    "backend:dev": "npm --prefix backend run dev",
    "backend:migrate": "npm --prefix backend run migrate",
    "backend:deploy": "npm --prefix backend run deploy",
    "backend:deploy:dry": "npm --prefix backend run deploy:dry",
    "mobile:apk": "powershell.exe -ExecutionPolicy Bypass -File mobile/build-apk.ps1",
    "mobile:install": "cd mobile && flutter pub get",
    "mobile:start": "cd mobile && flutter run",
    "mobile:android": "cd mobile && flutter run -d android",
    "mobile:web": "echo \"Sylica Mobile is Android-only in v1.\"",
    "mobile:typecheck": "cd mobile && flutter analyze",
    "dev": "cross-env NODE_ENV=development npm run clean && concurrently \"npm run backend:dev\" \"tsc -w -p tsconfig.electron.json\" \"vite\" \"wait-on -t 30000 tcp:127.0.0.1:8787 http://localhost:54321 && electron ./dist-electron/electron/main.js\"",
    "test": "echo \"No tests defined. Please contribute if you like\" && exit 0",
    "lint": "npx eslint .",
    "start": "cross-env NODE_ENV=development concurrently \"npm run backend:start\" \"tsc -p tsconfig.electron.json\" \"vite\" \"wait-on -t 30000 tcp:127.0.0.1:8787 http://localhost:54321 && electron ./dist-electron/electron/main.js\"",
    "build": "cross-env NODE_ENV=production npx rimraf dist dist-electron && vite build && tsc -p tsconfig.electron.json",
    "run-prod": "cross-env NODE_ENV=production SYLICA_LOCAL_DESKTOP_TEST=1 electron ./dist-electron/electron/main.js",
    "package": "cross-env NODE_ENV=production npx rimraf dist dist-electron && vite build && tsc -p tsconfig.electron.json && electron-builder build",
    "package-mac": "cross-env NODE_ENV=production npx rimraf dist dist-electron && vite build && tsc -p tsconfig.electron.json && electron-builder build --mac",
    "package-win": "cross-env NODE_ENV=production npx rimraf dist dist-electron && vite build && tsc -p tsconfig.electron.json && electron-builder build --win",
    "publish:android:apk": "node build/publish-android-apk.mjs",
    "publish:win:update": "node build/publish-windows-update.mjs",
    "release:android": "npm run mobile:apk && npm run publish:android:apk",
    "release:win:update": "npm run package-win && npm run publish:win:update"
  },
  "build": {
    "appId": "com.sylica.ai.desktop",
    "productName": "Sylica AI",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "asar": true,
    "compression": "maximum",
    "generateUpdatesFilesForAllChannels": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Sylica-AI-${arch}.${ext}",
      "icon": "assets/icons/mac/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Developer ID Application",
      "notarize": true,
      "protocols": {
        "name": "sylica-ai-protocol",
        "schemes": [
          "sylica-ai"
        ]
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/win/icon.ico",
      "artifactName": "Sylica-AI-Windows-${version}.${ext}",
      "protocols": {
        "name": "sylica-ai-protocol",
        "schemes": [
          "sylica-ai"
        ]
      },
      "executableName": "SylicaAI"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/logo.svg",
      "artifactName": "Sylica-AI-Linux-${version}.${ext}",
      "protocols": {
        "name": "sylica-ai-protocol",
        "schemes": [
          "sylica-ai"
        ]
      }
    },
    "extraResources": [
      {
        "from": ".env",
        "to": ".env",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "shortcutName": "Sylica AI",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "interview",
    "coding",
    "interview prep",
    "technical interview",
    "tool"
  ],
  "author": "Sylica AI Contributors",
  "license": "AGPL-3.0-or-later",
  "description": "Sylica AI is an invisible desktop application to help you pass technical interviews.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@electron/notarize": "^3.1.1",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.64.0",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "electron-log": "^5.2.4",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.1",
    "katex": "^0.16.45",
    "lucide-react": "^0.460.0",
    "openai": "^4.28.4",
    "pg": "^8.20.0",
    "puppeteer-core": "^24.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.1",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "screenshot-desktop": "^1.15.0",
    "stripe": "^18.5.0",
    "tailwind-merge": "^2.5.5",
    "uuid": "^11.0.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@electron/typescript-definitions": "^9.1.6",
    "@eslint/css": "^0.6.0",
    "@eslint/js": "^9.24.0",
    "@eslint/json": "^0.11.0",
    "@eslint/markdown": "^6.3.0",
    "@types/color": "^4.2.0",
    "@types/diff": "^6.0.0",
    "@types/electron-store": "^1.3.1",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/screenshot-desktop": "^1.12.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/utils": "^8.29.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "eslint": "^8.57.1",
    "eslint-flat-config-utils": "^2.0.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^16.0.0",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.2",
    "vite": "^6.2.5",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
